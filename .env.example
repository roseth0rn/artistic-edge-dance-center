# Coolify → Application → Environment Variables (runtime only; nothing is
# needed at build time in this repo).

NODE_ENV=production
PORT=3000

# Internal Coolify Postgres URL (service name on the shared Docker network,
# never the public IP). Example resource name: aedc-db
DATABASE_URL=postgres://USER:PASSWORD@aedc-db:5432/postgres

# openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
